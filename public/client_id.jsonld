{
  "@context": [ "https://www.w3.org/ns/solid/oidc-context.jsonld" ],

  "client_id": "https://kellermeister.ch/client_id.jsonld",
  "client_name": "Kellermeister",
  "redirect_uris": [ "https://kellermeister.ch/" ],
  "post_logout_redirect_uris": [ "https://kellermeister.ch/logout" ],
  "client_uri": "https://kellermeister.ch/",
  "logo_uri": "https://kellermeister.ch/icon-512.png",
  "tos_uri": "https://kellermeister.ch/tos.html",
  "scope": "openid webid offline_access",
  "grant_types": [ "refresh_token", "authorization_code" ],
  "response_types": [ "code" ],
  "default_max_age": 3600,
  "require_auth_time": true
}