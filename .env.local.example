# Runtime vars
FRONTEND_DEPLOYMENT_URL=
FRONTEND_SHOW_DOMAIN_NOTICE=1
FRONTEND_ROBOTS_TAG=none

# Build time vars
VITE_BUILD_VERSION=local

# Endpoint of the order-conversion service (POST JSON {front, back} base64 -> Turtle).
# Set to MOCKED to return a fixed built-in order without any network request.
VITE_ORDER_CONVERSION_URL=https://kellerknecht.fly.dev/convert
