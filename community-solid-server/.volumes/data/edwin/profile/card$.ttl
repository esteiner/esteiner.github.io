@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix solid: <http://www.w3.org/ns/solid/terms#>.
@prefix pim: <http://www.w3.org/ns/pim/space#>.

<http://localhost:3000/edwin/profile/card> a foaf:PersonalProfileDocument;
    foaf:maker <#me>;
    foaf:primaryTopic <#me>.
<#me> a foaf:Person;
    solid:oidcIssuer <http://localhost:3000/>;
    pim:storage <http://localhost:3000/edwin/>;
    pim:preferencesFile <http://localhost:3000/edwin/settings/prefs.ttl>;
    solid:publicTypeIndex <http://localhost:3000/edwin/settings/publicTypeIndex.ttl>.
