# Credentials for the pre-seeded test account on the local Pod server
# (WebID: http://localhost:3000/edwin/profile/card#me).
# Copy this file to e2e/.env and fill in the real values. e2e/.env is gitignored.
E2E_EMAIL=you@example.com
E2E_PASSWORD=change-me

# Optional: point the tests at an already-running app instead of the one
# Playwright starts. Defaults to http://localhost:5173 (Vite dev server).
# E2E_BASE_URL=http://localhost:5173
