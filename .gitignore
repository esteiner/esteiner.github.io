/community-solid-server/.volumes/data/.internal/locks/
/community-solid-server/.volumes/data/.internal/idp/adapter/AuthorizationCode/
/community-solid-server/.volumes/data/.internal/idp/adapter/Client/
/community-solid-server/.volumes/data/.internal/idp/adapter/Grant/
/community-solid-server/.volumes/data/.internal/idp/adapter/grants/
/community-solid-server/.volumes/data/.internal/idp/adapter/RefreshToken/
/community-solid-server/.volumes/data/.internal/idp/adapter/RegistrationAccessToken/
