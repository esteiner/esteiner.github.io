# Ignore all IntelliJ stuff and include the important things
# @see https://intellij-support.jetbrains.com/hc/en-us/articles/206544839
/.idea/*
!/.idea/codeStyles/
!/.idea/jsLinters/
!/.idea/runConfigurations/
!/.idea/codeStyleSettings.xml
!/.idea/encodings.xml
!/.idea/prettier.xml
*.iml

# ASDF
.tool-versions

/dist/
/docs/
/node_modules/
/public/shoelace/
/public/sitemap.xml
/coverage/

/.env.local

# E2E test credentials and auth state
/e2e/.env
/e2e/.auth/

# LLMs
CLAUDE.local.md
**/.claude/settings.local.json

/playwright-report/
/test-results/

/.lighthouseci/

# MacOS
.DS_Store

