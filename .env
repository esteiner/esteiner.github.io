# Runtime vars
FRONTEND_DEPLOYMENT_URL=https://kellermeister.ch
FRONTEND_SITE_TITLE='Kellermeister'
FRONTEND_SITE_DESCRIPTION='Kellermeister verwaltet deinen Weinkeller.'
FRONTEND_SITE_NAME=Kellermeiseter
FRONTEND_ROBOTS_TAG=all
FRONTEND_SHOW_DOMAIN_NOTICE=0

# Build time vars
VITE_BUILD_VERSION=default

# Endpoint of the order-conversion service that turns bottle photos into an
# order (Turtle). Empty disables the "Hinzufügen" photo capture feature.
# Set to MOCKED to return a fixed built-in order without any network request.
VITE_ORDER_CONVERSION_URL=https://kellerknecht.fly.dev/convert
